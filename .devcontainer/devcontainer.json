{
  "name": "opencode",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/shyim/devcontainers-features/bun:0": {
      "version": "1.3.14"
    }
  },
  "hostRequirements": {
    "memory": "8gb"
  },
  "postCreateCommand": "curl -fsSL https://qlty.sh | bash && bun install",
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.qlty/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["oven.bun-vscode", "esbenp.prettier-vscode", "oxc.oxc-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
